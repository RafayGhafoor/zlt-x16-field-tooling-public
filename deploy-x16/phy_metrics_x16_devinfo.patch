         return 3
     fi
     # One awk pass over both captures: every payload line names its own command,
     # so no section marker is needed and an empty group is simply no lines.
-    printf '%s\n%s\n' "$cap_a" "$cap_b" \
-        | awk -v beam_max="$QM_PHY_BEAM_MAX" "$QM_PHY_AT_AWK"
+    out=$(printf '%s\n%s\n' "$cap_a" "$cap_b" \
+        | awk -v beam_max="$QM_PHY_BEAM_MAX" "$QM_PHY_AT_AWK")
+
+    # AT+QNWCFG is Quectel and this module is SIMCom, where the shim answers it
+    # with a bare OK: the awk pass then anchors on nothing and every field stays
+    # unset. If the parse yielded no number at all, take the same fields from
+    # the vendor devinfo store instead. A device where QNWCFG really works never
+    # reaches this branch, so its behaviour is unchanged.
+    # MERGE, do not switch. The two sources answer for different fields: the AT
+    # half now carries `lte_mimo_layers` (the shim synthesises it from the
+    # modem's rank) while the store carries CQI/RI/MCS. An either-or choice
+    # loses one set whichever way it goes -- the earlier "is the parse
+    # non-empty?" test picked the AT half the moment MIMO started working and
+    # silently blanked CQI/RI again.
+    #
+    # Precedence: AT value if it is a real number, otherwise the store's.
+    # Nulls are stripped from the AT object first, because jq's `*` merge lets
+    # the right-hand side win and a null there would erase a good store value.
+    _alt=$(qm_phy_x16_at 2>/dev/null) || _alt=""
+    case "$out" in
+        *'{'*) ;;
+        *)     out='{}' ;;
+    esac
+    if [ -n "$_alt" ]; then
+        _merged=$(printf '%s\n%s\n' "$out" "$_alt" | "$(_qm_phy_jq)" -s -c '
+            .[0] as $at | .[1] as $store
+            | ($at | walk(if type == "object"
+                          then with_entries(select(.value != null))
+                          else . end)) as $atv
+            | $store * $atv' 2>/dev/null)
+        [ -n "$_merged" ] && out="$_merged"
+    fi
+    case "$out" in
+        *'{'*) printf '%s\n' "$out" ;;
+        *)     return 3 ;;
+    esac
     return 0
 }
 
