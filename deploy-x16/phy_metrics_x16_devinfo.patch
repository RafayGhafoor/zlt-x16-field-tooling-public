+
+# =============================================================================
+# SOURCE 1b — the vendor devinfo store (ZLT X16 / SIMCom SIM8260E)
+# =============================================================================
+# This firmware has no ubus and no modemd, and the AT half below speaks
+# AT+QNWCFG, which is Quectel: SIMCom has no such command, so both halves of
+# Tier 3 returned nothing and every PHY figure except the Tier-1 basics
+# published null while the stock UI showed CQI, RI and MCS.
+#
+# Those numbers do exist, in the vendor dialer's own dump of its devinfo table:
+# /tmp/.devinfo_module_data, world-readable, rewritten about once a second, with
+# the stock UI's own field names (CQI, CQI_5G, lte_rank, nr_rank, DL_MCS_5G,
+# network_type_str, sim_status...). Reading it costs one `cat` and no AT lock,
+# unlike AT+SPENGMD=0,0,6 -- the dialer's real source, served only on its
+# private channel and answered with ERROR through atcmd_daemon.
+#
+# Everything here FAILS SOFT: a missing or stale file returns non-zero and the
+# caller keeps exactly today's behaviour. A stale file is not a reading, and an
+# absent value is null, never 0.
+#
+# QM_PHY_DEVINFO_TTL is deliberately short: the dialer rewrites the file ~1 Hz,
+# so 30 s old means the dialer has stopped and the values are history.
+QM_PHY_DEVINFO_FILE="${QM_PHY_DEVINFO_FILE:-/tmp/.devinfo_module_data}"
+QM_PHY_DEVINFO_TTL="${QM_PHY_DEVINFO_TTL:-30}"
+
+# 0 fresh, 2 absent/unreadable/undatable, 3 stale
+_qm_phy_devinfo() {
+    [ -r "$QM_PHY_DEVINFO_FILE" ] || return 2
+    local m
+    m=$(date -r "$QM_PHY_DEVINFO_FILE" +%s 2>/dev/null) || return 2
+    case "$m" in ''|*[!0-9]*) return 2 ;; esac
+    [ $(( $(date +%s) - m )) -le "$QM_PHY_DEVINFO_TTL" ] || return 3
+    cat "$QM_PHY_DEVINFO_FILE"
+}
+
+# devinfo -> the modemd-shaped object. ONLY `registered` is taken from here,
+# because that key is modemd-only in QM_PHY_SNAPSHOT_JQ and would otherwise stay
+# null on a box that is plainly attached. sim_status==1 plus a non-empty
+# network_type_str is the same pair the vendor UI labels "connected"; a missing
+# key yields null rather than a fabricated false.
+qm_phy_x16_modemd() {
+    local jq
+    _qm_phy_devinfo >/dev/null || return $?
+    jq=$(_qm_phy_jq) || return 2
+    _qm_phy_devinfo | "$jq" -R -s -c '
+      [ split("\n")[] | select(test("^[A-Za-z0-9_]+:"))
+        | capture("^(?<k>[A-Za-z0-9_]+):(?<v>.*)$") | {key:.k, value:.v} ] | from_entries as $d
+      | def num($k): ($d[$k] // "") | if test("^[0-9]+$") then tonumber else null end;
+      {registered: (if ($d.sim_status // "") == "" then null
+                    elif ($d.sim_status == "1") and ((($d.network_type_str // "") | length) > 0)
+                    then true
+                    # sim_status PRESENT and not "1" -> definitively not
+                    # registered, which is a fact worth publishing. Only a
+                    # MISSING sim_status is unknown (null). Collapsing both to
+                    # null hides a no-SIM/no-registration condition behind
+                    # "not reported" -- caught by tests/unit_phy_devinfo.sh.
+                    else false end),
+         carrier: null, rat: null, cqi: num("CQI"), nr_cqi: num("CQI_5G"),
+         # The rank IS the DL layer count, and MIMO_STATUS is empty on this unit,
+         # so rank is the only honest source for the MIMO Layers row. Filled here
+         # as well as in the shim because this object is the reliable path: the
+         # AT compound that carries the same number can be cut short by the
+         # per-call timeout on a busy cycle.
+         lte_mimo_layers: num("lte_rank"), nr_mimo_layers: num("nr_rank"),
+         lte_tm_mode: null,
+         lte_rank: num("lte_rank"), nr_rank: num("nr_rank")}'
+}
+
+# devinfo -> the AT-shaped object, so QM_PHY_AT_AWK's output contract and
+# QM_PHY_SNAPSHOT_JQ need no change at all.
+#
+# Range gates are the point: the store writes 0 for "not reported" in CQI/RI
+# (CQI 1-15, RI 1-8) but 0 is a REAL MCS index, so MCS keeps 0 and CQI does not.
+qm_phy_x16_at() {
+    local jq
+    _qm_phy_devinfo >/dev/null || return $?
+    jq=$(_qm_phy_jq) || return 2
+    _qm_phy_devinfo | "$jq" -R -s -c '
+      [ split("\n")[] | select(test("^[A-Za-z0-9_]+:"))
+        | capture("^(?<k>[A-Za-z0-9_]+):(?<v>.*)$") | {key:.k, value:.v} ] | from_entries as $d
+      | def num($k; lo; hi): ($d[$k] // "") | if test("^-?[0-9]+$") then tonumber else null end
+                              | if type == "number" and . >= lo and . <= hi then . else null end;
+        def nt: ($d.network_type_str // "");
+      {lte: {cqi: num("CQI"; 1; 15), ri: num("lte_rank"; 1; 8), pmi: null,
+             mimo_layers: null, tm_mode: null, ul_mcs: num("UL_MCS"; 0; 31)},
+       nr:  {cqi: num("CQI_5G"; 1; 15), ri: num("nr_rank"; 1; 8), pmi: null,
+             mimo_layers: null, dl_mcs: num("DL_MCS_5G"; 0; 31),
+             ul_mcs: num("UL_MCS_5G"; 0; 31), tx_power: null},
+       rrc: {rat: (if (nt | test("^5G")) then "NR"
+                   elif (nt | length) > 0 then "LTE" else null end),
+             state: null},
+       beams: []}'
 }
 
