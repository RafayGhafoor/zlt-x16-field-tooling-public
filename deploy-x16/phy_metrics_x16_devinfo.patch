@@ -457,12 +554,55 @@
     cap_b="$_QM_PHY_CAP"
 
     if [ -z "$cap_a" ] && [ -z "$cap_b" ]; then
+        # No usable AT at all. Take the same fields from the vendor devinfo
+        # store if it is answering; only when it cannot either is this a
+        # failure. (Invariant unchanged: a partial or absent read never
+        # publishes a previous cycle's value.)
+        _alt=$(qm_phy_x16_at 2>/dev/null) || _alt=""
